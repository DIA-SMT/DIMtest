# DIM360 QA · variables de entorno
# Copiá este archivo a .env.local. Sin .env.local la app corre en modo local
# (PGlite en .local/pgdata, evidencias en .local/archivos, usuario admin@dim360.local / dim360-local).

# Postgres de la app. Sin esta variable: modo local.
# DATABASE_URL=postgres://usuario:clave@servidor:5432/dim360

# Conexión directa para `npm run db:migrar` si DATABASE_URL pasa por un pooler (puerto 6543 de Supabase).
# DIRECT_URL=postgres://usuario:clave@servidor:5432/dim360

# requerido | desactivado. Por defecto: requerido, salvo localhost.
# DATABASE_SSL=requerido

# Firma de las sesiones (relevador y equipo). 32 caracteres o más. Obligatoria en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# Carpeta de las evidencias (fotos y PDF). Tiene que persistir entre deploys.
# CARPETA_ARCHIVOS=/var/lib/dim360-qa/archivos

# Minutos que una prueba queda reservada para quien la empezó (5 a 240).
# RESERVA_MINUTOS=30

# nginx: los encabezados de seguridad los pone el proxy y la app no los repite.
# ENCABEZADOS_SEGURIDAD=nginx
