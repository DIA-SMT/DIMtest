# Configuración del agente Claude de DIM360 (D-015). Copiá este archivo a agente/.env
# en la máquina de la red municipal. agente/.env NO se sube a git.

# Dirección del panel y token de la máquina (Panel → Agente → Conexión de la máquina).
PANEL_URL=https://dim360.195-35-42-168.sslip.io
AGENTE_TOKEN=

# Credencial de Claude Code de la cuenta Team: en esta máquina, `claude setup-token`.
# No pongas ANTHROPIC_API_KEY: le ganaría a la cuenta Team.
CLAUDE_CODE_OAUTH_TOKEN=

# Carpeta con Dim360_back-copia, Dim360_front-copia y .claude/skills/dim360
CARPETA_DIM360=C:\repos\dim360

# Alias del servidor de test en ~/.ssh/config (con la clave SSH propia del agente).
SSH_DESTINO=dim360-test

# Opcionales
# CLAUDE_COMANDO=C:\Users\agente\.local\bin\claude.exe
# INTERVALO_SEGUNDOS=120
# MINUTOS_MAXIMOS=60
# MAX_TURNOS=150
# PAUSA_LIMITE_MINUTOS=30
